<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AvmUpdateRepository Condition="'$(AvmUpdateRepository)' == ''">akifk27/advanced-video-manager</AvmUpdateRepository>
    <ApplicationIcon>Assets\images\AVM.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\images\1gif.jpg" />
    <None Remove="Assets\images\2gif.jpg" />
    <None Remove="Assets\images\3video.jpg" />
    <None Remove="Assets\images\4video.jpg" />
    <None Remove="Assets\images\avmbanner.png" />
    <None Remove="Assets\images\historyimg.png" />
    <None Remove="Assets\images\linkimg.png" />
    <None Remove="Assets\images\settingimg.png" />
    <None Remove="Tools\deno.exe" />
    <None Remove="Tools\yt-dlp.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\images\AVM.ico" />
    <Content Include="Tools\deno.exe" Condition="Exists('Tools\deno.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\yt-dlp.exe" Condition="Exists('Tools\yt-dlp.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\images\1gif.jpg" />
    <Resource Include="Assets\images\2gif.jpg" />
    <Resource Include="Assets\images\3video.jpg" />
    <Resource Include="Assets\images\4video.jpg" />
    <Resource Include="Assets\images\avm-logo.png" />
    <Resource Include="Assets\images\avmbanner.png" />
    <Resource Include="Assets\images\historyimg.png" />
    <Resource Include="Assets\images\linkimg.png" />
    <Resource Include="Assets\images\settingimg.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\images\quickpanel.png" />
    <None Update="THIRD_PARTY_LICENSES\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\LICENSE;..\AVM-LICENSE-NOTICE.txt;..\TERMS.tr.txt;..\TERMS.en.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(AvmUpdateRepository)' != ''">
    <AssemblyMetadata Include="AvmUpdateRepository" Value="$(AvmUpdateRepository)" />
  </ItemGroup>
</Project>

