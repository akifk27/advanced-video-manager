<UserControl x:Class="avmsoftware.mediawindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:avmsoftware"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1300">

    <UserControl.Resources>

        <!-- Tarih seçici: AVM koyu tema -->
        <Style x:Key="HistoryDateStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#1C2447"/>
            <Setter Property="Foreground" Value="#F0E9FF"/>
            <Setter Property="BorderBrush" Value="#7550C5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="35"/>
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Background" Value="#1C2447"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <Style TargetType="Calendar">
                    <Setter Property="Background" Value="#171C39"/>
                    <Setter Property="Foreground" Value="#F0E9FF"/>
                    <Setter Property="BorderBrush" Value="#8055D7"/>
                </Style>
                <Style TargetType="CalendarDayButton">
                    <Setter Property="Foreground" Value="#E6DCFF"/>
                    <Setter Property="Background" Value="#20264A"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- MOR BUTON -->

        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#6534DC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9"
                        Padding="{TemplateBinding Padding}">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.82"
                                    Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- İKİNCİL BUTON -->
        <Style x:Key="OutlineButton"
               TargetType="Button"
               BasedOn="{StaticResource PurpleButton}">
            <Setter Property="Background" Value="#202A50"/>
        </Style>

        <!-- OYNATMA LİSTESİ SATIRLARI -->
        <Style x:Key="PlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#202A50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MOR SEÇİM KUTUSU -->
        <Style x:Key="PurpleCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Border x:Name="CheckBorder"
                                    Background="Transparent"
                                    BorderBrush="#7962E9"
                                    BorderThickness="1.5"
                                    CornerRadius="5"/>

                            <Path x:Name="CheckMark"
                                  Data="M 4,10 L 8,14 L 16,5"
                                  Stroke="White"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="#7138E8"/>
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="#9868FF"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="#B69AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MOR KAYDIRMA TUTAMACI -->
        <Style x:Key="PurpleThumb"
               TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#7544E9"
                                CornerRadius="5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#9868FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#A77BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KAYDIRMA ÇUBUĞU -->
        <Style x:Key="PurpleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="#121B38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#121B38"
                                CornerRadius="3">
                            <primitives:Track x:Name="PART_Track"
                                              IsDirectionReversed="True"
                                              Focusable="False">

                                <primitives:Track.DecreaseRepeatButton>
                                    <primitives:RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Opacity="0"
                                        Focusable="False"/>
                                </primitives:Track.DecreaseRepeatButton>

                                <primitives:Track.Thumb>
                                    <primitives:Thumb
                                        Style="{StaticResource PurpleThumb}"/>
                                </primitives:Track.Thumb>

                                <primitives:Track.IncreaseRepeatButton>
                                    <primitives:RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Opacity="0"
                                        Focusable="False"/>
                                </primitives:Track.IncreaseRepeatButton>
                            </primitives:Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- AVM İNDİRME İLERLEME ÇUBUĞU -->
        <Style x:Key="AvmProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#1B2547"/>
            <Setter Property="Foreground" Value="#7842ED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="#1B2547" CornerRadius="4"/>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" Background="#7842ED" CornerRadius="4"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SAĞ PANEL SEÇENEK STİLLERİ -->
        <Style x:Key="SettingsCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2E9FF"/>
            <Setter Property="Background" Value="#211538"/>
            <Setter Property="BorderBrush" Value="#6E49A5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" CornerRadius="11" Background="#211538"
                                    BorderBrush="#6E49A5" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6200B5" BlurRadius="13" Opacity="0.26" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <Grid Margin="12,0,9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#F2E9FF" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                                <Path Grid.Column="1" Data="M 2,5 L 7,10 L 12,5" Stroke="#C6A4FF"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton x:Name="DropToggle" Background="Transparent" BorderThickness="0"
                                          Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#211536" BorderBrush="#8456C5" BorderThickness="1"
                                        CornerRadius="10" MinWidth="155" Margin="0,5,0,8" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#080313" BlurRadius="20" Opacity="0.8" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource PurpleScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#9864D8"/>
                                <Setter TargetName="Shell" Property="Background" Value="#1A102C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EDE1FF"/>
                        <Setter Property="Background" Value="#211536"/>
                        <Setter Property="Padding" Value="9,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#291A43"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#362052"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Astronot vizörü: katmanlı mor cam ve yumuşak yansıma -->
        <Style x:Key="VisorDownloadButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="5,9">
                            <Border CornerRadius="19" Background="#7531DA" Opacity="0.85">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8D35FF" BlurRadius="27" ShadowDepth="0" Opacity="0.76"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="18" BorderBrush="#BC8BFF" BorderThickness="1.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                        <GradientStop Color="#A46CFF" Offset="0"/>
                                        <GradientStop Color="#6325CE" Offset="0.42"/>
                                        <GradientStop Color="#38117E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <Border Height="25" VerticalAlignment="Top" Margin="8,3,8,0" CornerRadius="13" Opacity="0.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F2DEFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Height="15" VerticalAlignment="Bottom" Margin="16,0,16,2" CornerRadius="9" Opacity="0.22" Background="#A06AFF"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7E9FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ARKA PLAN -->
        <Grid.Background>
            <RadialGradientBrush Center="0.70,0.08"
                                 GradientOrigin="0.70,0.08"
                                 RadiusX="0.95"
                                 RadiusY="1.10">
                <GradientStop Color="#25206A" Offset="0"/>
                <GradientStop Color="#151C49" Offset="0.28"/>
                <GradientStop Color="#0D1533" Offset="0.58"/>
                <GradientStop Color="#080D1D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- ÜÇ SÜTUNLU ANA DÜZEN -->
        <Grid Margin="14,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27*"/>
                <ColumnDefinition Width="46*"/>
                <ColumnDefinition Width="27*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN: KAYITLI İNDİRMELER -->
            <Border Grid.Column="0" Margin="0,0,8,0" Background="#10172F"
                    BorderBrush="#303A67" BorderThickness="1" CornerRadius="16">
                <Grid Margin="13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="3,4,0,16">
                        <Image Source="/Assets/images/historyimg.png" Width="32" Height="32" Stretch="Uniform" Margin="0,0,9,0"/>
                        <TextBlock Text="{local:Localized Tr='İndirme Geçmişi', En='Download History'}" VerticalAlignment="Center" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HistoryAllButton" Grid.Column="0" Content="{local:Localized Tr='Tümü', En='All'}" Style="{StaticResource PurpleButton}" Margin="0,0,3,0" Click="HistoryAll_Click"/>
                        <Button x:Name="HistoryCompletedButton" Grid.Column="1" Content="{local:Localized Tr='Tamamlanan', En='Completed'}" Style="{StaticResource OutlineButton}" Margin="2,0" Click="HistoryCompleted_Click"/>
                        <Button x:Name="HistoryActiveButton" Grid.Column="2" Content="{local:Localized Tr='Devam Eden', En='In Progress'}" Style="{StaticResource OutlineButton}" Margin="3,0,0,0" Click="HistoryActive_Click"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Localized Tr='Tarih:', En='Date:'}" Foreground="#DBE1FF" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <DatePicker x:Name="HistoryDatePicker" Grid.Column="1" SelectedDateChanged="HistoryDate_Changed"
                                    Style="{StaticResource HistoryDateStyle}"/>
                        <Button Grid.Column="2" Content="{local:Localized Tr='Temizle', En='Clear'}" Style="{StaticResource OutlineButton}" Margin="5,0,0,0" Padding="8,7" Click="HistoryDateClear_Click"/>
                    </Grid>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False" SelectionMode="Single" SelectionChanged="HistoryList_SelectionChanged" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource PurpleScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#303A67" BorderThickness="1" CornerRadius="12" Padding="10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#292050"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#202448"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource PurpleCheckBox}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Grid Grid.Column="1" Width="59" Height="53" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Grid Background="Transparent" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" Visibility="{Binding SingleThumbVisibility}"/>
                                                <Grid Visibility="{Binding PlaylistBadgeVisibility}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                    <Image Grid.Column="1" Source="{Binding ThumbnailUrl2}" Stretch="UniformToFill"/>
                                                    <Image Grid.Column="2" Source="{Binding ThumbnailUrl3}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Grid>
                                            <Border Background="#171B38" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3,1" Visibility="{Binding PlaylistBadgeVisibility}">
                                                <TextBlock Text="▤" Foreground="#C6A2FF" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="2" Margin="3,0,5,0">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#BFC7EE" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DateLabel}" Foreground="#929FD2" FontSize="10" Margin="0,5,0,0"/>
                                            <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding ProgressPercent}"
                                                         Visibility="{Binding ActiveProgressVisibility}" Style="{StaticResource AvmProgressStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="#B9A1FF" FontSize="10" HorizontalAlignment="Right"/>
                                            <Button Content="{local:Localized Tr='Detay ›', En='Details ›'}" Visibility="{Binding PlaylistBadgeVisibility}" Style="{StaticResource OutlineButton}" FontSize="10" Padding="6,5"
                                                    Margin="0,8,0,0" Tag="{Binding}" Click="HistoryDetails_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="HistoryEmptyText" Text="{local:Localized Tr='Bu bölümde kayıt yok.', En='No entries in this section.'}" Foreground="#AFA8D9" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Visible"/>
                        <!-- Detay paneli yalnızca sol sütunun içinde açılır -->
                        <Border x:Name="HistoryDetailsPanel" Visibility="Collapsed" Background="#141C3C"
                                BorderBrush="#8051E5" BorderThickness="1" CornerRadius="12" Panel.ZIndex="10">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="10,6" Click="HistoryDetailsClose_Click"/>
                                    <TextBlock Text="{local:Localized Tr='İndirme Detayları', En='Download Details'}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="HistoryDetailsHeader" Grid.Row="1" Foreground="#D8C7FF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <ListBox x:Name="HistoryDetailsFiles" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PurpleScrollBar}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1C274B" CornerRadius="8" Padding="9" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#BAA8F6" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="#8996C7" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="4" Background="#1A2445" BorderBrush="#303A67" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="HistoryCountText" Text="{local:Localized Tr='Toplam video: 0', En='Total videos: 0'}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistorySizeText" Text="{local:Localized Tr='Seçili boyut: 0 B', En='Selected size: 0 B'}" Foreground="#C3A5FF" Margin="0,7,0,0"/>
                            <Button Content="{local:Localized Tr='Seçilen kayıtları sil', En='Delete selected entries'}" Style="{StaticResource OutlineButton}" Margin="0,10,0,0" Click="HistoryDelete_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ORTA SÜTUN -->
            <Grid Grid.Column="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BAĞLANTI GİRİŞ PANELİ -->
                <Border Grid.Row="0"
                        Background="#10172F"
                        BorderBrush="#303A67"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18,16"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                            <Image Source="/Assets/images/linkimg.png"
                                   Width="36"
                                   Height="36"/>

                            <TextBlock Text="{local:Localized Tr='Bağlantıyı Girin', En='Enter a Link'}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- URL GİRİŞİ: OVAL, PARLAK VE ANALİZ ANİMASYONLU -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- MOR CAM KAPSÜL: YUMUŞAK KÖŞE BUĞUSU -->
                            <Grid Grid.Column="0" Height="47">
                                <!-- Camın dış kenarında düşük yoğunluklu mor hale -->
                                <Border Margin="1" CornerRadius="17"
                                        Background="#332A124D"
                                        BorderBrush="#9A55E8" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7746E8" BlurRadius="28"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Border.Effect>
                                </Border>

                                <!-- İç yüzey: cam gibi hafif şişkin mor geçiş -->
                                <Border Margin="2" CornerRadius="16" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#D6A7FF" Offset="0"/>
                                            <GradientStop Color="#69309D" Offset="0.43"/>
                                            <GradientStop Color="#9752D1" Offset="0.75"/>
                                            <GradientStop Color="#D49AFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8650B3" Offset="0"/>
                                            <GradientStop Color="#482061" Offset="0.22"/>
                                            <GradientStop Color="#29113F" Offset="0.72"/>
                                            <GradientStop Color="#65308C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Üstte ince cam yansıması -->
                                <Border Margin="12,3,12,0" Height="12" VerticalAlignment="Top"
                                        CornerRadius="12" IsHitTestVisible="False" Opacity="0.46">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9CE5BBFF" Offset="0"/>
                                            <GradientStop Color="#00E4B5FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Analizde dolaşan geniş ve belirsiz mor ışık izi -->
                                <Rectangle x:Name="AnalyzingBorderLight"
                                           Margin="1.5" RadiusX="16" RadiusY="16"
                                           Fill="Transparent" StrokeThickness="3.2"
                                           StrokeDashArray="34 13 19 110"
                                           StrokeDashCap="Round"
                                           Opacity="0.65" IsHitTestVisible="False">
                                    <Rectangle.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#704A64E8" Offset="0"/>
                                            <GradientStop Color="#D1A58BFF" Offset="0.25"/>
                                            <GradientStop Color="#9A6356ED" Offset="0.56"/>
                                            <GradientStop Color="#D6B1A2FF" Offset="0.82"/>
                                            <GradientStop Color="#704A64E8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Stroke>
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="#7C50EF" BlurRadius="30"
                                                          ShadowDepth="0" Opacity="0.65"/>
                                    </Rectangle.Effect>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=AnalyzeButton}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="BorderLightAnimation">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                                                 From="0" To="-352"
                                                                                 Duration="0:0:6.8"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.50" To="0.82"
                                                                                 AutoReverse="True" Duration="0:0:2.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="BorderLightAnimation"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <Grid Margin="3,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="UrlBox"
                                             Grid.Column="0"
                                             Padding="11,8"
                                             Background="Transparent"
                                             Foreground="White"
                                             CaretBrush="White"
                                             BorderThickness="0"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             ToolTip="{local:Localized Tr='Video veya oynatma listesi bağlantısını girin', En='Enter a video or playlist URL'}"/>

                                    <!-- BAĞLANTIYI SİL -->
                                    <Button x:Name="ClearUrlButton"
                                            Grid.Column="1"
                                            Width="27"
                                            Height="27"
                                            Content="×"
                                            FontSize="19"
                                            Foreground="#D8C7FF"
                                            Background="#332653"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ToolTip="{local:Localized Tr='Bağlantıyı temizle', En='Clear link'}"
                                            Click="ClearUrlButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ClearButtonBackground"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ClearButtonBackground"
                                                                Property="Background"
                                                                Value="#6534DC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>

                            <Button x:Name="PasteButton"
                                    Grid.Column="1"
                                    Content="{local:Localized Tr='Yapıştır', En='Paste'}"
                                    Style="{StaticResource PurpleButton}"
                                    Margin="10,0,0,0"
                                    Click="PasteButton_Click"/>
                        </Grid>

                        <!-- ANALİZ BUTONU -->
                        <Button x:Name="AnalyzeButton"
                                Content="{local:Localized Tr='⌕  Bağlantıyı Dönüştür', En='⌕  Analyze Link'}"
                                Style="{StaticResource PurpleButton}"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                MinWidth="210"
                                Click="AnalyzeButton_Click"/>

                        <TextBlock x:Name="StatusText"
                                   Foreground="#B6C2EC"
                                   Text="{local:Localized Tr='Bağlantı girerek başlayın.', En='Enter a link to get started.'}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- VİDEO ÖNİZLEME PANELİ -->
                <Border Grid.Row="1"
                        Background="#10172F"
                        BorderBrush="#303A67"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14"
                        Margin="0,0,0,10"
                        MinHeight="145">

                    <Grid>
                        <!-- BOŞ ÖNİZLEME -->
                        <StackPanel x:Name="EmptyPreview"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="▷"
                                       FontSize="38"
                                       Foreground="#A78BFA"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{local:Localized Tr='Önizleme için bağlantı girin', En='Enter a link to preview'}"
                                       Foreground="#C7D2F4"
                                       FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- VİDEO BİLGİLERİ -->
                        <Grid x:Name="VideoPreview"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Background="#1B2546">
                                <Image x:Name="ThumbnailImage"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,2,0,0">
                                <TextBlock x:Name="VideoTitle"
                                           Text="Video"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           MaxHeight="66"/>

                                <TextBlock x:Name="VideoAuthor"
                                           Foreground="#CBD5F5"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="VideoDuration"
                                           Foreground="#CBD5F5"
                                           Margin="0,5,0,0"/>

                                <TextBlock x:Name="VideoResolution"
                                           Foreground="#CBD5F5"
                                           Margin="0,5,0,0"/>

                                <TextBlock x:Name="VideoSize"
                                           Foreground="#C084FC"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- OYNATMA LİSTESİ PANELİ -->
                <Border x:Name="PlaylistPanel"
                        Grid.Row="2"
                        Background="#10172F"
                        BorderBrush="#303A67"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12"
                        Visibility="Collapsed"
                        MinHeight="140">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LİSTE BAŞLIĞI -->
                        <DockPanel Grid.Row="0"
                                   Margin="0,0,0,10"
                                   LastChildFill="False">
                            <TextBlock Text="{local:Localized Tr='Oynatma Listesi İçeriği', En='Playlist Contents'}"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       DockPanel.Dock="Left"/>

                            <TextBlock x:Name="SelectedCountText"
                                       Text="{local:Localized Tr='Seçili: 0 / 0', En='Selected: 0 / 0'}"
                                       Foreground="#D8C7FF"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- VİDEO LİSTESİ -->
                        <ListBox x:Name="PlaylistList" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel" ScrollViewer.CanContentScroll="False"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource PurpleScrollBar}"/>
                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- MOR SEÇİM KUTUSU -->
                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource PurpleCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="PlaylistSelectionChanged"
                                                  Unchecked="PlaylistSelectionChanged"/>

                                        <!-- SIRA NUMARASI -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Index}"
                                                   Foreground="#B9C4E8"
                                                   VerticalAlignment="Center"/>

                                        <!-- VİDEO BAŞLIĞI -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Title}"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Title}"/>

                                        <!-- VİDEO SÜRESİ -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DurationText}"
                                                   Foreground="#B9C4E8"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- ALT BÖLÜM -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SEÇİM BUTONLARI -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal">
                                <Button Content="{local:Localized Tr='Tümünü Seç', En='Select All'}"
                                        Style="{StaticResource OutlineButton}"
                                        Click="SelectAll_Click"/>

                                <Button Content="{local:Localized Tr='Seçimi Kaldır', En='Clear Selection'}"
                                        Style="{StaticResource OutlineButton}"
                                        Margin="8,0,0,0"
                                        Click="ClearSelection_Click"/>
                                <Button x:Name="VerifyPlaylistSelectionButton"
                                        Content="{local:Localized Tr='✓ Seçimi Doğrula', En='✓ Verify Selection'}"
                                        Style="{StaticResource PurpleButton}"
                                        Margin="8,0,0,0"
                                        Click="VerifyPlaylistSelection_Click"/>
                            </StackPanel>

                            <!-- SÜRE VE BOYUT ÖZETİ -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">

                                <TextBlock x:Name="PlaylistSummary"
                                           Foreground="#D8C7FF"
                                           VerticalAlignment="Center"/>

                                <Border Width="1"
                                        Height="17"
                                        Background="#465A99"
                                        Margin="12,0"/>

                                <TextBlock x:Name="PlaylistSizeSummary"
                                           Text="{local:Localized Tr='Tahmini boyut: Hesaplanmadı', En='Estimated size: Not calculated'}"
                                           Foreground="#C084FC"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SAĞ SÜTUN: İNDİRME SEÇENEKLERİ -->
            <Border Grid.Column="2" Margin="8,0,0,0"
                    Background="#10172F" BorderBrush="#303A67"
                    BorderThickness="1" CornerRadius="16" Padding="17,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,19">
                        <Image Source="/Assets/images/settingimg.png" Width="32" Height="32"/>
                        <TextBlock Text="{local:Localized Tr='İndirme Seçenekleri', En='Download Options'}" FontSize="17" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    </StackPanel>

                    <!-- VİDEO / SES MODU -->
                    <Grid Grid.Row="1" Margin="0,0,0,19">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="VideoAudioMode" Grid.Column="0"
                                     GroupName="DownloadMode" IsChecked="True"
                                     Checked="DownloadMode_Changed" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ModeBorder" CornerRadius="10" Padding="9,12"
                                            Background="#151D3B" BorderBrush="#4B5689" BorderThickness="1">
                                        <TextBlock Text="▣ Video" Foreground="White" FontWeight="SemiBold"
                                                   FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ModeBorder" Property="Background" Value="#6730D8"/>
                                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#AB73FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                        <RadioButton x:Name="AudioOnlyMode" Grid.Column="2"
                                     GroupName="DownloadMode" Checked="DownloadMode_Changed" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ModeBorder" CornerRadius="10" Padding="9,12"
                                            Background="#151D3B" BorderBrush="#4B5689" BorderThickness="1">
                                        <TextBlock Text="{local:Localized Tr='♫  Sadece Ses', En='♫  Audio Only'}" Foreground="White" FontWeight="SemiBold"
                                                   FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ModeBorder" Property="Background" Value="#6730D8"/>
                                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#AB73FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Format" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="FormatCombo" Grid.Column="1" Style="{StaticResource SettingsCombo}" SelectionChanged="QualitySelection_Changed">
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="AudioBitrateRow" Grid.Row="3" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AudioBitrateLabel" Text="{local:Localized Tr='Ses Bit Hızı', En='Audio Bitrate'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="AudioBitrateCombo" Grid.Column="1" Style="{StaticResource SettingsCombo}" SelectionChanged="QualitySelection_Changed"/>
                    </Grid>
                    <Grid x:Name="ResolutionRow" Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Localized Tr='Çözünürlük', En='Resolution'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="ResolutionCombo" Grid.Column="1" Style="{StaticResource SettingsCombo}" SelectionChanged="QualitySelection_Changed">
                            <ComboBoxItem x:Name="BestResolutionItem" Content="{local:Localized Tr='En İyi (Analiz bekleniyor)', En='Best (Waiting for analysis)'}" IsSelected="True"/>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="AudioPcmRow" Grid.Row="4" Margin="0,0,0,18" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Localized Tr='WAV Kalitesi', En='WAV Quality'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="AudioPcmCombo" Grid.Column="1" Style="{StaticResource SettingsCombo}" SelectionChanged="QualitySelection_Changed">
                            <ComboBoxItem Content="44.1 kHz / 16 bit" Tag="44100" IsSelected="True"/>
                            <ComboBoxItem Content="48 kHz / 16 bit" Tag="48000"/>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="FpsRow" Grid.Row="4" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FPS" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="FpsCombo" Grid.Column="1" Style="{StaticResource SettingsCombo}" SelectionChanged="QualitySelection_Changed">
                            <ComboBoxItem x:Name="BestFpsItem" Content="{local:Localized Tr='En İyi (Analiz bekleniyor)', En='Best (Waiting for analysis)'}" IsSelected="True"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="0,0,0,15">
                        <TextBlock Text="{local:Localized Tr='▱  Çıktı Klasörü', En='▱  Output Folder'}" Foreground="White" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputFolderBox" Grid.Column="0" Background="#192345"
                                     BorderBrush="#4A568A" BorderThickness="1" Foreground="White"
                                     FontSize="12" Padding="9,10" VerticalContentAlignment="Center"
                                     ToolTip="{local:Localized Tr='İndirme klasörü (düzenlenebilir)', En='Download folder (editable)'}"/>
                            <Button Grid.Column="1" Content="▱" FontSize="21" Foreground="White"
                                    Background="#263460" BorderBrush="#4A568A" BorderThickness="1"
                                    Cursor="Hand" Click="BrowseFolder_Click" ToolTip="{local:Localized Tr='Klasör seç', En='Choose folder'}"/>
                        </Grid>
                    </StackPanel>

                    <!-- SEÇİM ÖZETİ -->
                    <Border Grid.Row="6" VerticalAlignment="Top" CornerRadius="11" Padding="13"
                            Background="#192345" BorderBrush="#303A67" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{local:Localized Tr='ⓘ  Seçim Özeti', En='ⓘ  Selection Summary'}" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,0,13"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SummaryCountLabel" Text="{local:Localized Tr='Seçilen Video:', En='Selected videos:'}" Foreground="#D5DCF8"/>
                                <TextBlock x:Name="DownloadSelectedCount" Grid.Column="1" Text="0"
                                           Foreground="White" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Localized Tr='◷  Toplam Süre:', En='◷  Total Duration:'}" Foreground="#D5DCF8"/>
                                <TextBlock x:Name="DownloadTotalDuration" Grid.Column="1" Text="--:--"
                                           Foreground="White" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Localized Tr='▤  Toplam Boyut:', En='▤  Total Size:'}" Foreground="#D5DCF8"/>
                                <TextBlock x:Name="DownloadTotalSize" Grid.Column="1" Text="{local:Localized Tr='Bilinmiyor', En='Unknown'}"
                                           Foreground="#C084FC" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock x:Name="SizeNote" Text="{local:Localized Tr='Boyut bilgisi bulunursa gösterilir.', En='Size is shown when available.'}"
                                       Foreground="#8C9BC9" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="7" Margin="0,14,0,0">
                        <Border x:Name="DownloadNotice" Visibility="Collapsed" Margin="0,0,0,9"
                                CornerRadius="8" Background="#262052" Padding="10,8">
                            <TextBlock x:Name="DownloadNoticeText" Text="{local:Localized Tr='İndiriliyor...', En='Downloading...'}"
                                       Foreground="#DAC4FF" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DownloadProgressInfo" Text="{local:Localized Tr='İndirme hazırlanıyor...', En='Preparing download...'}"
                                           Foreground="#C6B9F6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="DownloadItemCount" Visibility="Collapsed" Text="{local:Localized Tr='0/1 içerik', En='0/1 items'}" Foreground="#BDA4F5" FontSize="11" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DownloadProgressPercent" Text="0%"
                                           Foreground="#D5B6FF" FontWeight="Bold" FontSize="12" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="DownloadProgressBar" Height="9" Minimum="0" Maximum="100"
                                         Value="0" Style="{StaticResource AvmProgressStyle}"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PauseDownloadButton" Grid.Column="0" Content="{local:Localized Tr='⏸  Duraklat', En='⏸  Pause'}"
                                        IsEnabled="False" Style="{StaticResource OutlineButton}"
                                        Margin="0,0,5,0" Click="PauseDownloadButton_Click"/>
                                <Button x:Name="CancelDownloadButton" Grid.Column="1" Content="{local:Localized Tr='✕  İptal Et', En='✕  Cancel'}"
                                        IsEnabled="False" Background="#68253F" Style="{StaticResource PurpleButton}"
                                        Margin="5,0,0,0" Click="CancelDownloadButton_Click"/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="StartDownloadButton" Content="{local:Localized Tr='↓  İndirmeyi Başlat', En='↓  Start Download'}"
                                Style="{StaticResource VisorDownloadButton}" Click="StartDownloadButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
