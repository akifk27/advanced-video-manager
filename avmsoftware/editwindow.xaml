<UserControl x:Class="avmsoftware.editwindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:avmsoftware"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="700"
 IsVisibleChanged="PageVisibilityChanged" AllowDrop="True" DragOver="FileDragOver" Drop="FileDrop">
 <UserControl.Resources>
  <LinearGradientBrush x:Key="Neon" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#B975FF" Offset="0"/><GradientStop Color="#7838EB" Offset=".35"/>
   <GradientStop Color="#3A16A0" Offset=".65"/><GradientStop Color="#221446" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#F3F0FF"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#251B46" Offset="0"/><GradientStop Color="#151831" Offset=".5"/><GradientStop Color="#0C1529" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ColorPanelFill" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#382050" Offset="0"/><GradientStop Color="#1A1432" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SizePanelFill" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#183954" Offset="0"/><GradientStop Color="#0A2132" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="QuickNeonFill" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#412379" Offset="0"/><GradientStop Color="#2C1555" Offset=".45"/><GradientStop Color="#101936" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="QuickNeonEdge" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#FAAEFF" Offset="0"/><GradientStop Color="#A161FF" Offset=".5"/><GradientStop Color="#6451EF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#5A447A"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource PanelFill}"/>
   <Setter Property="Padding" Value="11"/>
  </Style>
  <Style x:Key="LegacyEditorButton" TargetType="Button">
   <Setter Property="Foreground" Value="#F8F4FF"/><Setter Property="Background" Value="#18223C"/>
   <Setter Property="BorderBrush" Value="#66508F"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="9,4"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#D39AFF"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".78"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".42"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource LegacyEditorButton}">
   <Setter Property="Background" Value="#202A50"/>
   <Setter Property="BorderBrush" Value="#46557C"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#8664BE"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#BB9BE5"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".8"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource EditorButton}">
   <Setter Property="Background" Value="#6534DC"/>
   <Setter Property="BorderBrush" Value="#8258DC"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource EditorButton}"/>
  <Style x:Key="NeonAction" TargetType="Button" BasedOn="{StaticResource LegacyEditorButton}">
   <Setter Property="Background" Value="{StaticResource Neon}"/><Setter Property="BorderBrush" Value="#BA76FF"/>
   <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="QuickNeonButton" TargetType="Button" BasedOn="{StaticResource LegacyEditorButton}">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid Margin="5">
       <Border x:Name="Glow" CornerRadius="13" Background="{StaticResource QuickNeonFill}"
        BorderBrush="{StaticResource QuickNeonEdge}" BorderThickness="1.5">
        <Border.Effect><DropShadowEffect Color="#A350FF" BlurRadius="20" ShadowDepth="0" Opacity=".85"/></Border.Effect>
       </Border>
       <Border Margin="4" CornerRadius="10" BorderThickness="1" BorderBrush="#4EA774F9" IsHitTestVisible="False"/>
       <ContentPresenter Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Glow" Property="Effect"><Setter.Value><DropShadowEffect Color="#D379FF" BlurRadius="27" ShadowDepth="0" Opacity="1"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Opacity" Value=".75"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="QuickApplyButton" TargetType="Button" BasedOn="{StaticResource LegacyEditorButton}">
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid x:Name="Surface" RenderTransformOrigin=".5,.5">
       <Border x:Name="Aura" Margin="2" CornerRadius="12" Background="#8655F9" Opacity=".62">
        <Border.Effect><DropShadowEffect Color="#A780FF" BlurRadius="17" ShadowDepth="0" Opacity=".85"/></Border.Effect>
       </Border>
       <Border CornerRadius="12" BorderThickness="1.4" BorderBrush="{StaticResource QuickNeonEdge}">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
          <GradientStop Color="#2C1766" Offset="0"/><GradientStop Color="#5833C2" Offset=".52"/>
          <GradientStop Color="#894DE3" Offset=".84"/><GradientStop Color="#80C8FB" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
       <Border x:Name="Glint" Margin="4" CornerRadius="9" Opacity=".35" IsHitTestVisible="False">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint=".3,1">
          <GradientStop Color="#C0FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset=".65"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
       <DockPanel Margin="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="✦" Foreground="#BDEAFF" FontSize="15" Margin="0,0,7,0"/>
        <ContentPresenter VerticalAlignment="Center"/>
       </DockPanel>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
         <BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Aura" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
          <DoubleAnimation Storyboard.TargetName="Glint" Storyboard.TargetProperty="Opacity" To=".78" Duration="0:0:0.22"/>
         </Storyboard></BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Aura" Storyboard.TargetProperty="Opacity" To=".62" Duration="0:0:0.28"/>
          <DoubleAnimation Storyboard.TargetName="Glint" Storyboard.TargetProperty="Opacity" To=".35" Duration="0:0:0.28"/>
         </Storyboard></BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".48"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <ControlTemplate x:Key="FormatScrollBar" TargetType="ScrollBar">
   <Grid Width="11" Margin="2,2,1,2" Background="#211936">
    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <Track.DecreaseRepeatButton>
      <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
       <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
      </RepeatButton>
     </Track.DecreaseRepeatButton>
     <Track.Thumb>
      <Thumb MinHeight="18">
       <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
         <Border x:Name="Grip" Margin="2,0" Background="{StaticResource QuickNeonEdge}" CornerRadius="4"/>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#E6A2FF"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Thumb.Template>
      </Thumb>
     </Track.Thumb>
     <Track.IncreaseRepeatButton>
      <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
       <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
      </RepeatButton>
     </Track.IncreaseRepeatButton>
    </Track>
   </Grid>
  </ControlTemplate>
  <Style x:Key="EditorSlider" TargetType="Slider">
   <Setter Property="Foreground" Value="#A966FF"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Height="20" Background="Transparent">
       <Border Height="5" Margin="5,0" Background="#3D315C" CornerRadius="3"/>
       <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="5" Background="#A25AF8" CornerRadius="3"/></Grid></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="13" Height="13">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F0DEFF" Stroke="#A25AF8" StrokeThickness="2"/></ControlTemplate></Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Slider" BasedOn="{StaticResource EditorSlider}"/>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#161E34"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#524675"/><Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#161E34"/>
   <Setter Property="BorderBrush" Value="#524675"/><Setter Property="MinHeight" Value="26"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="#161E34" BorderBrush="#524675" BorderThickness="1" CornerRadius="6"/>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <DockPanel IsHitTestVisible="False" Margin="7,0">
        <TextBlock DockPanel.Dock="Right" Text="⌄" Margin="5,0,0,0"/>
        <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
       </DockPanel>
       <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
        <Border Background="#10172B" BorderBrush="#7751A4" BorderThickness="1" CornerRadius="6"
         MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
         <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources>
           <Style TargetType="ScrollBar"><Setter Property="Template" Value="{StaticResource FormatScrollBar}"/></Style>
          </ScrollViewer.Resources>
          <ItemsPresenter/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="7,4"/>
   <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#6332BB"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.Background>
   <RadialGradientBrush Center="0.70,0.08" GradientOrigin="0.70,0.08" RadiusX="0.95" RadiusY="1.10">
    <GradientStop Color="#25206A" Offset="0"/><GradientStop Color="#151C49" Offset="0.28"/>
    <GradientStop Color="#0D1533" Offset="0.58"/><GradientStop Color="#080D1D" Offset="1"/>
   </RadialGradientBrush>
  </Grid.Background>
  <Grid Margin="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="73*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="27*" MinWidth="285"/></Grid.ColumnDefinitions>
   <Grid x:Name="EditingArea" Grid.Column="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="144"/><RowDefinition Height="9"/><RowDefinition Height="*" MinHeight="192"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*" MinWidth="205"/></Grid.ColumnDefinitions>
     <Border x:Name="PreviewHost" Style="{StaticResource Card}" Background="#EC10172B" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=EditorToolsColumn}">
      <Grid x:Name="PlayerSurface">
       <Grid.Resources>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource LegacyEditorButton}">
         <Setter Property="MinWidth" Value="34"/>
         <Setter Property="Margin" Value="2,0"/>
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="16">
             <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#D39AFF"/></Trigger>
             <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E7C5FF"/></Trigger>
             <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".78"/></Trigger>
             <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".42"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}"/>
        <Style x:Key="PlayerAccent" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
         <Setter Property="Background" Value="{StaticResource Neon}"/>
         <Setter Property="BorderBrush" Value="#BA76FF"/>
         <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource EditorSlider}"/>
        <Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="#F3F0FF"/>
         <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
       </Grid.Resources>
       <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="22"/><RowDefinition Height="38"/></Grid.RowDefinitions>
       <Border Background="#050812" CornerRadius="8" ClipToBounds="True">
        <Grid>
         <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
          ScrubbingEnabled="True" MediaOpened="PlayerOpened" MediaEnded="PlayerEnded" MediaFailed="PlayerFailed"/>
         <Image x:Name="FrameImage" Stretch="Uniform" Visibility="Collapsed"/>
         <Button x:Name="OpenOverlay" Content="{local:Localized Tr='Video seç veya buraya bırak', En='Select or drop a video'}" Click="OpenVideo" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NeonAction}"/>
         <Button x:Name="CenterPlay" Style="{StaticResource PlayerAccent}" Content="▶" FontSize="22" Width="64" Height="48" Click="TogglePlay"
          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
         <Border x:Name="Updating" Background="#99050812" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock Text="{local:Localized Tr='Güncelleniyor…', En='Updating…'}" HorizontalAlignment="Center" FontSize="17"/>
         </Border>
        </Grid>
       </Border>
       <Slider x:Name="SeekBar" Grid.Row="1" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" IsEnabled="False"
        PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" ToolTip="{local:Localized Tr='Oynatma konumu', En='Playback position'}"/>
       <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="ClockLabel" Text="00:00 / 00:00" FontSize="11"/>
        
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" x:Name="Transport"  Orientation="Horizontal" IsEnabled="False">
         <Button Content="⏮" Click="GoStart" ToolTip="{local:Localized Tr='Başa git', En='Go to start'}" Padding="8,3" AutomationProperties.Name="{local:Localized Tr='Başa git', En='Go to start'}"/>
         <Button Content="‹" Tag="-1" Click="FrameClick" PreviewMouseLeftButtonDown="FramePressed"
          PreviewMouseLeftButtonUp="FrameReleased" LostMouseCapture="FrameCaptureLost" ToolTip="{local:Localized Tr='1 kare geri', En='Previous frame'}" Padding="8,3" AutomationProperties.Name="{local:Localized Tr='1 kare geri', En='Previous frame'}"/>
         <Button x:Name="PlayButton" Style="{StaticResource PlayerAccent}" MinWidth="40" Content="▶" Click="TogglePlay" ToolTip="{local:Localized Tr='Oynat / Duraklat', En='Play / Pause'}" Padding="8,3"/>
         <Button Content="›" Tag="1" Click="FrameClick" PreviewMouseLeftButtonDown="FramePressed"
          PreviewMouseLeftButtonUp="FrameReleased" LostMouseCapture="FrameCaptureLost" ToolTip="{local:Localized Tr='1 kare ileri', En='Next frame'}" Padding="8,3" AutomationProperties.Name="{local:Localized Tr='1 kare ileri', En='Next frame'}"/>
         <Button Content="⏭" Click="GoEnd" ToolTip="{local:Localized Tr='Sona git', En='Go to end'}" Padding="8,3" AutomationProperties.Name="{local:Localized Tr='Sona git', En='Go to end'}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Slider x:Name="VolumeBar"  Width="52" Margin="3,0" Maximum="1" Value=".7"
         ValueChanged="VolumeChanged" ToolTip="{local:Localized Tr='Önizleme ses seviyesi', En='Preview volume'}"/>
        <Button x:Name="MuteButton"  Content="♪" Click="ToggleMute" ToolTip="{local:Localized Tr='Önizleme sesini kapat / aç', En='Mute / unmute preview audio'}" Padding="7,3"/>
       <Button x:Name="FullscreenButton"  Content="⛶" Click="ToggleFullscreen" ToolTip="{local:Localized Tr='Tam ekran', En='Full screen'}" Padding="8,3"/></StackPanel></Grid>
      </Grid>
     </Border>
     <Grid x:Name="EditorToolsColumn" Grid.Column="2" VerticalAlignment="Top">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel LastChildFill="False">
         <TextBlock Text="{local:Localized Tr='ⓘ  Video Bilgileri', En='ⓘ  Video Information'}" Style="{StaticResource Heading}"/>
         <Button DockPanel.Dock="Right" Content="{local:Localized Tr='Aç', En='Open'}" Click="OpenVideo" Padding="6,1" MinHeight="23" Margin="0,0,0,4"/>
        </DockPanel>
        <TextBlock x:Name="SourceInfo" Text="{local:Localized Tr='Video seçilmedi', En='No video selected'}" TextWrapping="Wrap" FontSize="12"/>
       </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{local:Localized Tr='✂  Düzenleme Araçları', En='✂  Editing Tools'}" Style="{StaticResource Heading}"/>
        <UniformGrid x:Name="EditButtons" Columns="3" IsEnabled="False">
         <Button x:Name="CutTool" Content="{local:Localized Tr='✂  Kes', En='✂  Cut'}" Click="SelectCut" Margin="1" Padding="3"/>
         <Button x:Name="DeleteTool" Click="SelectDelete" Margin="1" Padding="3">
          <StackPanel Orientation="Horizontal"><Path Width="13" Height="13" Stretch="Uniform" Stroke="#EDE0FF" StrokeThickness="1.3" Data="M 1,3 L 12,3 M 4,3 L 4,1 L 9,1 L 9,3 M 2.5,3 L 3.3,12 L 9.7,12 L 10.5,3 M 5,5 L 5,10 M 8,5 L 8,10" Margin="0,0,4,0"/><TextBlock Text="{local:Localized Tr='Sil', En='Delete'}"/></StackPanel>
         </Button>
         <Button x:Name="UndoButton" Content="{local:Localized Tr='↶  Geri Al', En='↶  Undo'}" Click="UndoEdit" Margin="1" Padding="3" IsEnabled="False"/>
        </UniformGrid>
       </StackPanel>
      </Border>
      <Border Grid.Row="4" Style="{StaticResource Card}" Padding="7,2">
       <DockPanel><Button DockPanel.Dock="Right" Content="+" Click="ZoomIn" ToolTip="{local:Localized Tr='Zaman çizelgesini yakınlaştır', En='Zoom in on timeline'}"/>
        <Button DockPanel.Dock="Left" Content="−" Click="ZoomOut" ToolTip="{local:Localized Tr='Zaman çizelgesini uzaklaştır', En='Zoom out on timeline'}"/>
        <Slider x:Name="Zoom" Minimum="1" Maximum="120" Value="1" Margin="6,0" ValueChanged="ZoomChanged"/>
       </DockPanel>
      </Border>
      <Border Grid.Row="5" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,7,0,0">
       <StackPanel>
        <TextBlock Text="{local:Localized Tr='Klip Ses Düzeyi', En='Clip Volume'}" Style="{StaticResource Heading}"/>
        <TextBlock x:Name="ClipGainLabel" Text="{local:Localized Tr='Zaman çizelgesinden bir ses klibi seçin.', En='Select an audio clip on the timeline.'}" TextWrapping="Wrap" FontSize="12"/>
        <Slider x:Name="ClipGain" IsEnabled="False" Minimum="0" Maximum="3" Value="1"
         TickFrequency=".05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,4,0,0"
         ValueChanged="ClipGainChanged" Thumb.DragCompleted="ClipGainDragCompleted" LostKeyboardFocus="ClipGainLostFocus"
         AutomationProperties.Name="{local:Localized Tr='Klip Ses Düzeyi', En='Clip Volume'}"/>
       </StackPanel>
      </Border>
     </Grid>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="9,6">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
      <StackPanel Margin="0,35,0,0">
       <TextBlock Text="▣  Video" Height="32"/><TextBlock Text="{local:Localized Tr='♫  Ses', En='♫  Audio'}" Height="32"/>
      </StackPanel>
      <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
       SizeChanged="TimelineSizeChanged" ScrollChanged="TimelineScrolled">
       <Canvas x:Name="Timeline" Height="105" Background="Transparent" ClipToBounds="True"
        MouseLeftButtonDown="TimelinePressed" MouseMove="TimelineMoved" MouseLeave="TimelineMouseLeave" MouseLeftButtonUp="TimelineReleased"/>
      </ScrollViewer>
      <Grid Grid.Row="1" Grid.Column="1" Background="#201835" ClipToBounds="True">
       <Canvas x:Name="Overview" Background="Transparent" SizeChanged="OverviewSizeChanged" Cursor="SizeWE"
        MouseLeftButtonDown="OverviewPressed" MouseMove="OverviewMoved" MouseLeftButtonUp="OverviewReleased"/>
      </Grid>
      <TextBlock x:Name="TimelinePosition" Grid.Row="1" FontSize="11"/>
     </Grid>
    </Border>
    <Grid Grid.Row="4" MinHeight="192">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.30*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.00*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.02*" MinWidth="194"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}">
      <Grid>
       <Button RenderTransformOrigin=".5,.5" x:Name="QuickCover" Click="ShowQuickSettings" Style="{StaticResource QuickNeonButton}">
        <StackPanel HorizontalAlignment="Center">
         <TextBlock Text="{local:Localized Tr='Hızlı ayarlar için tıklayın', En='Click for Quick Settings'}" FontSize="20" Foreground="#FFCDB8E5" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Franklin Gothic Demi"/>
        </StackPanel>
       </Button>
       <StackPanel x:Name="QuickSettings" Visibility="Collapsed">
        <DockPanel LastChildFill="False">
         <TextBlock Text="{local:Localized Tr='Hızlı Ayarlar', En='Quick Settings'}" Style="{StaticResource Heading}"/>
         <Button DockPanel.Dock="Right" Content="×" Click="HideQuickSettings" MinHeight="20" Padding="5,0" Margin="0,0,0,4"/>
        </DockPanel>
        <TextBlock Text="{local:Localized Tr='Dosya Boyutu', En='File Size'}"/><ComboBox x:Name="QuickSize" Margin="0,3,0,6"/>
        <TextBlock Text="{local:Localized Tr='Video Türü', En='Video Type'}"/><ComboBox x:Name="QuickType" Margin="0,3,0,8"/>
        <Button x:Name="QuickApply" Content="{local:Localized Tr='Hızlı Ayar Uygula', En='Apply Quick Settings'}" Click="ApplyQuickSettings" Style="{StaticResource QuickApplyButton}" IsEnabled="False"/>
       </StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#A64BB9" Background="{StaticResource ColorPanelFill}">
      <StackPanel>
       <TextBlock Text="{local:Localized Tr='☷  Renk Ayarları', En='☷  Color Settings'}" Style="{StaticResource Heading}"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="63"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/></Grid.RowDefinitions>
        <TextBlock Text="{local:Localized Tr='Parlaklık', En='Brightness'}"/><TextBlock Grid.Row="1" Text="{local:Localized Tr='Kontrast', En='Contrast'}"/><TextBlock Grid.Row="2" Text="{local:Localized Tr='Doygunluk', En='Saturation'}"/><TextBlock Grid.Row="3" Text="{local:Localized Tr='Pozlama', En='Exposure'}"/>
        <Slider x:Name="Brightness" Grid.Column="1" Minimum="-25" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewSettingChanged"/>
        <Slider x:Name="Contrast" Grid.Row="1" Grid.Column="1" Minimum="-25" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewSettingChanged"/>
        <Slider x:Name="Saturation" Grid.Row="2" Grid.Column="1" Minimum="-25" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewSettingChanged"/>
        <Slider x:Name="Exposure" Grid.Row="3" Grid.Column="1" Minimum="-25" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewSettingChanged"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=Brightness, StringFormat=0}"/>
        <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=Contrast, StringFormat=0}"/>
        <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=Saturation, StringFormat=0}"/>
        <TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=Exposure, StringFormat=0}"/>
       </Grid>
      </StackPanel>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource Card}" BorderBrush="#139FB7" Background="{StaticResource SizePanelFill}">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
       </Grid.RowDefinitions>
       <StackPanel>
        <TextBlock Text="{local:Localized Tr='▤  Tahmini Boyut', En='▤  Estimated Size'}" Style="{StaticResource Heading}" FontSize="17" Margin="0,0,0,5"/>
        <TextBlock x:Name="OriginalSize" Text="{local:Localized Tr='Orijinal: —', En='Original: —'}" Foreground="#CEE3F4" FontSize="13"/>
       </StackPanel>
       <Button Grid.Row="1" x:Name="CalculateButton" Content="{local:Localized Tr='Hesapla', En='Calculate'}" Click="CalculateSize" IsEnabled="False"
        MinHeight="32" Margin="0,9,0,8"/>
       <Border Grid.Row="2" Padding="8,4" CornerRadius="8" Background="#60254860"
        BorderBrush="#46749AAB" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
         <TextBlock x:Name="EstimatedSize" Text="{local:Localized Tr='Mevcut: —', En='Output: —'}" Foreground="#80F0FF" FontSize="17"
          FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
         <TextBlock x:Name="SizeChange" Foreground="#93F0BC" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
         <TextBlock x:Name="EstimateStatus" Foreground="#FFCF8E" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
    </Grid>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="{local:Localized Tr='⚙  Çıktı Ayarları', En='⚙  Output Settings'}" Style="{StaticResource Heading}" FontSize="19"/>
      <UniformGrid Columns="3" Margin="0,0,0,8">
       <Button x:Name="VideoModeButton" Content="{local:Localized Tr='▣  Video + Ses', En='▣  Video + Audio'}" Style="{StaticResource Accent}" Click="SetVideoMode" Margin="0,0,4,0"/>
       <Button x:Name="AudioModeButton" Content="{local:Localized Tr='♫  Sadece Ses', En='♫  Audio Only'}" Click="SetAudioMode" Margin="2,0"/><Button x:Name="GifModeButton" Content="GIF" Click="SetGifMode" Margin="2,0,0,0"/>
      </UniformGrid>
      <TextBlock Text="Format"/><ComboBox x:Name="FormatBox" Margin="0,2,0,6" SelectionChanged="FormatChanged"/>
      <StackPanel x:Name="VideoOptions">
       <TextBlock Text="{local:Localized Tr='Çözünürlük', En='Resolution'}"/><ComboBox x:Name="ResolutionBox" Margin="0,2,0,6" SelectionChanged="PreviewSettingChanged"/>
       <TextBlock Text="{local:Localized Tr='En Boy Oranı', En='Aspect Ratio'}"/><ComboBox x:Name="RatioBox" Margin="0,2,0,2" SelectionChanged="PreviewSettingChanged"/>
       <TextBlock x:Name="OutputDimensions" Foreground="#B9A8DD" Margin="0,0,0,5"/>
       <TextBlock Text="FPS"/><ComboBox x:Name="FpsBox" Margin="0,2,0,6" SelectionChanged="PreviewSettingChanged"/>
       <TextBlock x:Name="VideoCodecLabel" Text="{local:Localized Tr='Video Kodek', En='Video Codec'}"/><ComboBox x:Name="VideoCodecBox" Margin="0,2,0,6" SelectionChanged="EstimateSettingChanged"/>
      </StackPanel>
      <StackPanel x:Name="AudioOptions"><TextBlock Text="{local:Localized Tr='Ses Kodek', En='Audio Codec'}"/><ComboBox x:Name="AudioCodecBox" Margin="0,2,0,6" SelectionChanged="EstimateSettingChanged"/>
      </StackPanel><StackPanel x:Name="BitrateOptions"><DockPanel><TextBlock x:Name="BitrateValue" DockPanel.Dock="Right" Foreground="#DCB4FF"/><TextBlock x:Name="BitrateLabel" Text="Video bitrate"/></DockPanel>
       <Slider x:Name="BitrateSlider" IsMoveToPointEnabled="True" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BitrateChanged" AutomationProperties.Name="Bitrate"/>
       <TextBlock x:Name="BitrateRange" FontSize="10" Foreground="#B9A8DD" Margin="0,0,0,7"/>
      </StackPanel><TextBlock Text="{local:Localized Tr='▱  Çıktı Klasörü', En='▱  Output Folder'}" Style="{StaticResource Heading}" Margin="0,2,0,3"/>
      <DockPanel Margin="0,0,0,7">
       <Button DockPanel.Dock="Right" Content="…" Click="ChooseFolder" ToolTip="{local:Localized Tr='Çıktı klasörünü seç', En='Choose output folder'}" Margin="4,0,0,0"/>
       <TextBox x:Name="OutputFolder"/>
      </DockPanel>
      <TextBlock Text="{local:Localized Tr='▤  Çıkış Adı', En='▤  Output Name'}" Style="{StaticResource Heading}" Margin="0,2,0,3"/>
      <TextBox x:Name="OutputName" Margin="0,0,0,8"/>
      <Button x:Name="ExportButton" Content="{local:Localized Tr='↓  Dışa Aktar (Dönüştür)', En='↓  Export (Convert)'}" Style="{StaticResource NeonAction}" MinHeight="40"
       Click="ExportVideo" IsEnabled="False"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#D2BDEF" Margin="0,5,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>

  <Grid x:Name="QuickBusy" Visibility="Collapsed" Background="#C2070817" Panel.ZIndex="99">
   <Border Style="{StaticResource Card}" BorderBrush="{StaticResource QuickNeonEdge}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,28" MinWidth="350">
    <Border.RenderTransform><TranslateTransform x:Name="QuickCardShift"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#9851EF" BlurRadius="28" ShadowDepth="0" Opacity=".65"/></Border.Effect>
    <StackPanel>
     <Grid Width="42" Height="42" Margin="0,0,0,17" RenderTransformOrigin=".5,.5">
      <Grid.RenderTransform><RotateTransform x:Name="QuickSpinner"/></Grid.RenderTransform>
      <Ellipse Stroke="#483069" StrokeThickness="4"/>
      <Path Data="M 21,2 A 19,19 0 0 1 40,21" Stroke="#E4A4FF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Grid>
     <TextBlock Text="{local:Localized Tr='Sizin için en iyi ayarları uyguluyoruz…', En='Applying the best settings for your video…'}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>

